{
  "name": "AI_Healthcare_Data_Flywheel",
  "email_notifications": {
    "no_alert_for_skipped_runs": false
  },
  "webhook_notifications": {},
  "timeout_seconds": 0,
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "Bronze_Ingest",
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/Workspace/Shared/AI-Healthcare/databricks_notebooks/01_bronze_ingest",
        "base_parameters": {
          "pipeline_mode": "batch"
        },
        "source": "WORKSPACE"
      },
      "job_cluster_key": "Shared_Job_Cluster",
      "timeout_seconds": 0,
      "email_notifications": {}
    },
    {
      "task_key": "Silver_Cleaning",
      "depends_on": [
        {
          "task_key": "Bronze_Ingest"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/Workspace/Shared/AI-Healthcare/databricks_notebooks/02_silver_cleaning",
        "base_parameters": {
          "pipeline_mode": "batch"
        },
        "source": "WORKSPACE"
      },
      "job_cluster_key": "Shared_Job_Cluster",
      "timeout_seconds": 0,
      "email_notifications": {}
    },
    {
      "task_key": "Gold_Aggregations",
      "depends_on": [
        {
          "task_key": "Silver_Cleaning"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/Workspace/Shared/AI-Healthcare/databricks_notebooks/03_gold_aggregations",
        "base_parameters": {
          "pipeline_mode": "batch"
        },
        "source": "WORKSPACE"
      },
      "job_cluster_key": "Shared_Job_Cluster",
      "timeout_seconds": 0,
      "email_notifications": {}
    },
    {
      "task_key": "Kaggle_GPU_Scoring",
      "depends_on": [
        {
          "task_key": "Gold_Aggregations"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/Workspace/Shared/AI-Healthcare/databricks_notebooks/04_gpu_risk_scoring",
        "source": "WORKSPACE"
      },
      "job_cluster_key": "Shared_Job_Cluster",
      "timeout_seconds": 0,
      "email_notifications": {}
    },
    {
      "task_key": "MLflow_Model_Retraining",
      "depends_on": [
        {
          "task_key": "Silver_Cleaning"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/Workspace/Shared/AI-Healthcare/databricks_notebooks/06_mlflow_training",
        "source": "WORKSPACE"
      },
      "job_cluster_key": "Shared_Job_Cluster",
      "timeout_seconds": 0,
      "email_notifications": {}
    }
  ],
  "job_clusters": [
    {
      "job_cluster_key": "Shared_Job_Cluster",
      "new_cluster": {
        "cluster_name": "",
        "spark_version": "14.3.x-scala2.12",
        "node_type_id": "i3.xlarge",
        "autoscale": {
          "min_workers": 1,
          "max_workers": 2
        },
        "data_security_mode": "USER_ISOLATION"
      }
    }
  ],
  "format": "MULTI_TASK"
}
